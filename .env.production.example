# ─────────────────────────────────────────────────────────────
# 온결 프로덕션 환경변수
#   cp .env.production.example .env.production && 값을 채운다.
#   배포: docker compose --env-file .env.production up -d --build
# 이 파일은 커밋하지 않는다 (.gitignore 의 .env*).
# ─────────────────────────────────────────────────────────────

# ── 공개 도메인 (Cloudflare Tunnel) ──
# 인그레스는 로컬 파일이 아니라 Zero Trust 대시보드에 있다:
#   one.dash.cloudflare.com → Networks → Tunnels → Public Hostnames
#   Public Hostname 하나만 추가한다 (단일 오리진):
#     ongyeol.cloudrainit.com → http://host.docker.internal:4500   (nginx)
# nginx 가 /api/* 를 api 로, 나머지를 web 으로 프록시하므로 web/api 오리진이 하나다.
# (쿠키 SameSite=Lax/secure 제약이 사라지고 CORS 도 필요 없다.)

# ── 프로덕션 PostgreSQL ──
# prod-postgres 컨테이너와 같은 도커 네트워크(prod-postgres_default)에서 호스트명 `db` 로 접속.
# 자격증명은 ~/dev/postgres/prod/.env.prod 의 APP_USER/APP_PASSWORD 와 동일하다.
# 초기 1회, prod-postgres 에 전용 DB 를 만든다 (app_rw 소유):
#   docker exec prod-postgres psql -U postgres -c "CREATE DATABASE ongyeol OWNER app_rw ENCODING 'UTF8'"
DATABASE_URL="postgresql://app_rw:APP_PASSWORD@db:5432/ongyeol?schema=public"

# ── API 서버 ──
JWT_SECRET="CHANGE_ME_openssl_rand_base64_48"
# 브라우저 오리진 (프론트 도메인). 콤마로 여러 개 가능.
CORS_ORIGIN="https://ongyeol.cloudrainit.com"
# 업로드 파일 공개 URL 의 베이스 (nginx 가 /api 접두사를 제거해 API 로 넘긴다)
PUBLIC_API_URL="https://ongyeol.cloudrainit.com/api"
# 토스페이먼츠 시크릿 키 (실서비스 전 라이브 키로 교체)
TOSS_SECRET_KEY="test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R"

# ── 프론트엔드 (NEXT_PUBLIC_* 는 빌드 시 번들에 인라인됨 → 변경 시 재빌드 필요) ──
NEXT_PUBLIC_API_URL="https://ongyeol.cloudrainit.com/api"
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq"