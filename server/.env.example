# PostgreSQL 연결 문자열 (docker-compose.yml 과 일치)
DATABASE_URL="postgresql://ongyeol:ongyeol@localhost:5433/ongyeol?schema=public"

# API 서버 포트
PORT=4000

# JWT 서명 키 (운영에서는 반드시 교체)
JWT_SECRET="change-me-in-production"

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGIN="http://localhost:3000"

# 업로드 파일 공개 URL 의 베이스 (운영에서는 브라우저에서 접근 가능한 API 주소)
PUBLIC_API_URL="http://localhost:4000"

# 토스페이먼츠 시크릿 키
TOSS_SECRET_KEY="test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R"

# 업로드 파일 저장 디렉터리 (기본 ./uploads)
# UPLOAD_DIR="./uploads"

# 시드 관리자 계정
SEED_ADMIN_EMAIL="admin@ongyeol.com"
SEED_ADMIN_PASSWORD="admin1234!"